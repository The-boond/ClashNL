+// URLTestResult runs one synchronous URL test for a concrete outbound. It is
+// used by short-lived headless libbox sessions that do not need the command
+// stream or the asynchronous history observer.
+func (s *StartedService) URLTestResult(outboundTag string) (uint16, error) {
+	s.serviceAccess.RLock()
+	if s.serviceStatus.Status != ServiceStatus_STARTED {
+		s.serviceAccess.RUnlock()
+		return 0, os.ErrInvalid
+	}
+	boxService := s.instance
+	s.serviceAccess.RUnlock()
+
+	outbound, isLoaded := boxService.outboundManager.Outbound(outboundTag)
+	if !isLoaded {
+		return 0, status.Error(codes.NotFound, "outbound not found: "+outboundTag)
+	}
+	if _, isGroup := outbound.(adapter.OutboundGroup); isGroup {
+		return 0, status.Error(codes.InvalidArgument, "outbound is a group: "+outboundTag)
+	}
+	return urltest.URLTest(boxService.ctx, "", outbound)
+}
